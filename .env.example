# Alpaca paper trading (https://alpaca.markets)
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# AI provider (OpenAI-compatible endpoint)
# Examples:
#   OpenAI:     https://api.openai.com/v1
#   Groq:       https://api.groq.com/openai/v1
#   Ollama:     http://localhost:11434/v1
#   OpenRouter: https://openrouter.ai/api/v1
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.1
AI_MAX_TOKENS=150

# Reddit OAuth (script-type app — no user login required)
# Register at https://www.reddit.com/prefs/apps → create "script" type app
# Set redirect URI to http://localhost:8080 (unused but required by Reddit)
REDDIT_USER_AGENT=wsb-trader/0.1 by u/yourhandle
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Data source toggles (set to "false" to disable)
ENABLE_REDDIT=true
ENABLE_YAHOO=true
ENABLE_STOCKTWITS=true
ENABLE_4CHAN=false

# Trading parameters
POLL_INTERVAL_SECONDS=300
MIN_MENTIONS=3
MIN_CONFIDENCE=0.75
POSITION_SIZE_USD=1000
MAX_POSITIONS=5
